# Copie para .env para testar localmente (NÃO commite o .env).
# No Netlify, cadastre as mesmas variáveis em Site configuration > Environment variables.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-public

# --- SEO e campanhas (todos opcionais) ---
# Endereço final do site, sem barra no fim. No Netlify, se ficar vazio, ele usa a URL do site automaticamente.
SITE_URL=https://www.seu-dominio.com.br
# Google Analytics 4 (começa com G-)
GA4_ID=
# Google Ads (começa com AW-)
GOOGLE_ADS_ID=
# Meta Pixel (Facebook/Instagram Ads): só números
META_PIXEL_ID=
# Código de verificação do Google Search Console (só o valor do content="...")
GOOGLE_SITE_VERIFICATION=
